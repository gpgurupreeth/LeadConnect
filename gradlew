#!/usr/bin/env sh
#
# Gradle wrapper script for Android project
# Generated by Antigravity
#
# This script will download the Gradle distribution if not already present.
# It expects the wrapper JAR at ./gradle/wrapper/gradle-wrapper.jar
# and the properties file at ./gradle/wrapper/gradle-wrapper.properties

DEFAULT_JVM_OPTS=""
APP_NAME="gradlew"
EXECUTABLE_NAME="gradle"

# Find the location of the script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Resolve the path to the wrapper JAR
WRAPPER_JAR="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper JAR not found at $WRAPPER_JAR. Attempting to download..."
  # The wrapper JAR will be automatically downloaded by the wrapper itself if missing.
fi

# Execute the wrapper
java $DEFAULT_JVM_OPTS -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
