# Server Configuration
# Port 8080 is commonly occupied by Apache/XAMPP; this project uses 8081.
PORT=8081
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Secret - MUST be at least 32 characters long.
# Generate a secure development secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-byte-hex-string-for-local-dev-only

# JWT token expiration in minutes (default: 5 minutes)
JWT_EXPIRATION_MINUTES=5

# WhatsApp provider selection.
# Default is disabled: no message can be sent until explicitly enabled.
# Allowed values: disabled, waha
WHATSAPP_PROVIDER=disabled

# WAHA gateway (server-side only; never put this key in the Android APK).
# See backend-proxy/waha/README.md for the local Docker setup.
WAHA_ENABLE_LIVE=false
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=replace-with-the-same-waha-api-key-used-by-the-waha-container
WAHA_SESSION=default
WAHA_VERIFY_SESSION=true

# Legacy WA-AKG settings. The WA-AKG provider is no longer selected; these are
# retained only so older local .env files continue to load.
# WAAKG_ENABLE_LIVE=false
# WAAKG_BASE_URL=http://localhost:3000
# WAAKG_API_KEY=replace-with-waakg-api-key

# Safety & Rate Limiting Controls
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=65536
UPSTREAM_TIMEOUT_SECONDS=10.0
IDEMPOTENCY_TTL_SECONDS=86400
