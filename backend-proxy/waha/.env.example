# WAHA server-side secrets.
# Copy this file to .env and replace both values with random strings.
# NEVER commit the real .env file or paste these values into the Android APK.
#
# Generate values (PowerShell):
#   $bytes = New-Object byte[] 32
#   $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
#   $rng.GetBytes($bytes)
#   -join ($bytes | ForEach-Object { $_.ToString('x2') })

WAHA_API_KEY=replace-with-a-random-64-character-hex-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-random-dashboard-password
